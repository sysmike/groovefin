<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings: measure Groovefin product assemblies only. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Groovefin\.[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
