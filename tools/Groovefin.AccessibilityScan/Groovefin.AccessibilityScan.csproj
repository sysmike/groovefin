<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Axe.Windows rules, the automated checks of Accessibility Insights FastPass, on the running app
    (#51). The smoke test calls it on each page it visits. Windows only; not shipped with the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Axe.Windows" />
  </ItemGroup>

</Project>
