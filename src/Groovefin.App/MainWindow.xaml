<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Groovefin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:notifications="using:Groovefin.Core.Notifications"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <!--  Keyboard shortcuts (Space, Ctrl+…) are handled in PreviewKeyDown, see KeyboardShortcuts.  -->
    <Grid x:Name="RootGrid" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Grid.ColumnSpan="2"
            BackRequested="OnTitleBarBackRequested"
            IsBackButtonEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    MinWidth="240"
                    MaxWidth="{StaticResource SearchBoxMaxWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind Suggestions.Suggestions}"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                    TextChanged="OnSearchTextChanged"
                    TextMemberPath="Title">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchSuggestion">
                            <Grid
                                Padding="0,4"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind conv:Glyphs.Suggestion(Kind)}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            Expanding="OnNavigationExpanding"
            ItemInvoked="OnNavigationItemInvoked"
            PaneDisplayMode="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="NavAlbums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavArtists" Tag="artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSongs" Tag="songs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGenres" Tag="genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Expands to the user's playlists (loaded each time), which take dropped tracks and albums.  -->
                <NavigationViewItem
                    x:Name="PlaylistsNavItem"
                    x:Uid="NavPlaylists"
                    AllowDrop="True"
                    DragEnter="OnPlaylistsNavDragEnter"
                    HasUnrealizedChildren="True"
                    Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFolders" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFavourites" Tag="favourites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!--  Errors and other notifications, newest at the bottom.  -->
                <ItemsControl
                    x:Name="NotificationArea"
                    x:Uid="NotificationArea"
                    MaxWidth="{StaticResource PageContentMaxWidth}"
                    Margin="36,12,36,0"
                    VerticalAlignment="Top"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="notifications:AppNotification">
                            <InfoBar
                                Title="{x:Bind Title}"
                                Margin="0,0,0,8"
                                CloseButtonClick="OnNotificationCloseButtonClick"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind conv:NotificationSeverityConverter.ToInfoBarSeverity(Severity)}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </NavigationView>

        <!--
            Full-screen player (F11, Esc exits): the album art blurred behind everything but the now playing
            bar, the cover large on the left. The queue and lyrics panes stay usable on top of it. Only loaded
            while shown, so its images are not fetched otherwise.
        -->
        <Grid
            x:Name="FullScreenBackdrop"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            x:Load="{x:Bind Player.IsFullScreen, Mode=OneWay}"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Image
                controls:Artwork.Request="{x:Bind Player.BackdropCover, Mode=OneWay}"
                AutomationProperties.AccessibilityView="Raw"
                Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush
                        FallbackColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintOpacity="0.55" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid
            x:Name="FullScreenContent"
            Grid.RowSpan="2"
            Padding="48,32"
            x:Load="{x:Bind Player.IsFullScreen, Mode=OneWay}"
            ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                x:Uid="FullScreenExitButton"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Command="{x:Bind Player.ExitFullScreenCommand}">
                <FontIcon FontSize="16" Glyph="&#xE73F;" />
            </Button>
            <Viewbox
                Grid.Row="1"
                MaxWidth="480"
                MaxHeight="480"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Grid
                    Width="480"
                    Height="480"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <FontIcon
                        FontSize="96"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE93C;" />
                    <Image
                        controls:Artwork.Request="{x:Bind Player.LargeCover, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="UniformToFill" />
                </Grid>
            </Viewbox>
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    MaxLines="3"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind Player.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Player.ArtistNames, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="18"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Player.AlbumName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!--  Ctrl+Q or the now playing bar's queue button.  -->
        <controls:QueuePanel
            x:Name="QueuePane"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind Queue.IsOpen, Mode=OneWay}" />

        <!--  Ctrl+L or the now playing bar's lyrics button; it shares the place of the queue.  -->
        <controls:LyricsPanel
            x:Name="LyricsPane"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind Lyrics.IsOpen, Mode=OneWay}" />

        <!--  Shown once something is queued.  -->
        <controls:NowPlayingBar
            x:Name="NowPlaying"
            Grid.Row="2"
            Grid.ColumnSpan="2" />
    </Grid>
</Window>
