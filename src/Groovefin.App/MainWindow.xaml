<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Groovefin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:notifications="using:Groovefin.Core.Notifications"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="K"
                Invoked="OnFocusSearchInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            BackRequested="OnTitleBarBackRequested"
            IsBackButtonEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    MinWidth="240"
                    MaxWidth="{StaticResource SearchBoxMaxWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnNavigationItemInvoked"
            PaneDisplayMode="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="NavAlbums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavArtists" Tag="artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSongs" Tag="songs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGenres" Tag="genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPlaylists" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFolders" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFavourites" Tag="favourites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!--  Errors and other notifications, newest at the bottom.  -->
                <ItemsControl
                    x:Name="NotificationArea"
                    x:Uid="NotificationArea"
                    MaxWidth="{StaticResource PageContentMaxWidth}"
                    Margin="36,12,36,0"
                    VerticalAlignment="Top"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="notifications:AppNotification">
                            <InfoBar
                                Title="{x:Bind Title}"
                                Margin="0,0,0,8"
                                CloseButtonClick="OnNotificationCloseButtonClick"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind conv:NotificationSeverityConverter.ToInfoBarSeverity(Severity)}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
