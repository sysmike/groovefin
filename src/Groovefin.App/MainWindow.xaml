<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Groovefin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:notifications="using:Groovefin.Core.Notifications"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <!--  Keyboard shortcuts (Space, Ctrl+…) are handled in PreviewKeyDown, see KeyboardShortcuts.  -->
    <Grid x:Name="RootGrid" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Grid.ColumnSpan="2"
            BackRequested="OnTitleBarBackRequested"
            IsBackButtonEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!--  The search box, and privacy mode beside it (#234): accent-coloured while on.  -->
                <Grid
                    MaxWidth="{StaticResource TitleBarContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="SearchBox"
                        MinWidth="240"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind Suggestions.Suggestions}"
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        TextChanged="OnSearchTextChanged"
                        TextMemberPath="Title">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchSuggestion">
                                <Grid
                                    Padding="0,4"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind conv:Glyphs.Suggestion(Kind)}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ToggleButton
                        x:Name="PrivacyButton"
                        x:Uid="PrivacyButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PrivacyButton"
                        IsChecked="{x:Bind Privacy.IsOn, Mode=TwoWay}">
                        <FontIcon FontSize="16" Glyph="&#xED1A;" />
                    </ToggleButton>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            Expanding="OnNavigationExpanding"
            ItemInvoked="OnNavigationItemInvoked"
            PaneDisplayMode="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="NavAlbums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavArtists" Tag="artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSongs" Tag="songs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGenres" Tag="genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Expands to the user's playlists (loaded each time), which take dropped tracks and albums.  -->
                <NavigationViewItem
                    x:Name="PlaylistsNavItem"
                    x:Uid="NavPlaylists"
                    AllowDrop="True"
                    DragEnter="OnPlaylistsNavDragEnter"
                    HasUnrealizedChildren="True"
                    Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFolders" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavFavourites" Tag="favourites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  The tracks played most in the last 30 days (#251).  -->
                <NavigationViewItem x:Uid="NavOnRepeat" Tag="onrepeat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!--  The page: the main landmark (#51), so Narrator can jump to it.  -->
            <controls:LandmarkGrid
                x:Uid="MainContent"
                AutomationProperties.AutomationId="MainContent"
                AutomationProperties.LandmarkType="Main">
                <Frame x:Name="ContentFrame" />

                <!--  Errors and other notifications, newest at the bottom.  -->
                <ItemsControl
                    x:Name="NotificationArea"
                    x:Uid="NotificationArea"
                    MaxWidth="{StaticResource PageContentMaxWidth}"
                    Margin="36,12,36,0"
                    VerticalAlignment="Top"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="notifications:AppNotification">
                            <InfoBar
                                Title="{x:Bind Title}"
                                Margin="0,0,0,8"
                                CloseButtonClick="OnNotificationCloseButtonClick"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind conv:NotificationSeverityConverter.ToInfoBarSeverity(Severity)}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:LandmarkGrid>
        </NavigationView>

        <!--
            Full-screen player (F11, Esc exits): the album art blurred behind everything but the now playing
            bar, the cover large on the left. The queue and lyrics panes stay usable on top of it. Its covers
            are only set while it is shown, so they are not fetched otherwise. (x:Load does not work in a Window.)
        -->
        <Grid
            x:Name="FullScreenBackdrop"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="{x:Bind Player.IsFullScreen, Mode=OneWay}">
            <Image
                controls:Artwork.Request="{x:Bind Player.BackdropCover, Mode=OneWay}"
                AutomationProperties.AccessibilityView="Raw"
                Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush
                        FallbackColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintOpacity="0.55" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid
            x:Name="FullScreenContent"
            Grid.RowSpan="2"
            Padding="48,32"
            ColumnSpacing="48"
            Visibility="{x:Bind Player.IsFullScreen, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                x:Uid="FullScreenExitButton"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Command="{x:Bind Player.ExitFullScreenCommand}">
                <FontIcon FontSize="16" Glyph="&#xE73F;" />
            </Button>
            <Viewbox
                Grid.Row="1"
                MaxWidth="480"
                MaxHeight="480"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Grid
                    Width="480"
                    Height="480"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <FontIcon
                        FontSize="96"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE93C;" />
                    <Image
                        controls:Artwork.Request="{x:Bind Player.LargeCover, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="UniformToFill" />
                </Grid>
            </Viewbox>
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    MaxLines="3"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind Player.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Player.ArtistNames, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="18"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Player.AlbumName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!--  Ctrl+Q or the now playing bar's queue button.  -->
        <controls:QueuePanel
            x:Name="QueuePane"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind Queue.IsOpen, Mode=OneWay}" />

        <!--  Ctrl+L or the now playing bar's lyrics button; it shares the place of the queue.  -->
        <controls:LyricsPanel
            x:Name="LyricsPane"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="{x:Bind Lyrics.IsOpen, Mode=OneWay}" />

        <!--  Shown once something is queued.  -->
        <controls:NowPlayingBar
            x:Name="NowPlaying"
            Grid.Row="2"
            Grid.ColumnSpan="2" />

        <!--
            Mini player (Ctrl+M): the window becomes a small always-on-top overlay with the cover on the left,
            title and artist to its right and the transport below them (#181). The window opens at 420 × 140 and
            can be resized within limits (#183, MiniPlayer* in code); made larger, the layout stays centred and
            the cover stays square. The top strip is the title bar while it is shown; the button returns to the
            full window.
        -->
        <Grid
            x:Name="MiniPlayer"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="{x:Bind Player.IsMiniPlayer, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="MiniTitleBar" Background="Transparent" />
            <Grid
                Grid.Row="1"
                Margin="12,0,12,12"
                VerticalAlignment="Center"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="96"
                    Height="96"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <FontIcon
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE93C;" />
                    <Image
                        controls:Artwork.Request="{x:Bind Player.MiniCover, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="UniformToFill" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Player.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Player.ArtistNames, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="MiniPreviousButton" Command="{x:Bind Player.PreviousCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE892;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind Player.PlayPauseName, Mode=OneWay}"
                                Command="{x:Bind Player.PlayPauseCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind Player.PlayPauseName, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.PlayPause(Player.IsPlaying), Mode=OneWay}" />
                            </Button>
                            <Button x:Uid="MiniNextButton" Command="{x:Bind Player.NextCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE893;" />
                            </Button>
                        </StackPanel>
                        <Button
                            x:Uid="MiniExitButton"
                            HorizontalAlignment="Right"
                            Command="{x:Bind Player.ExitMiniPlayerCommand}">
                            <FontIcon FontSize="14" Glyph="&#xE73F;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
