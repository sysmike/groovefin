<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.PlaylistNavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        A favourite playlist in the expanded navigation pane (#299): its cover, then its name and below it the
        track count and length. The item itself carries the name for Narrator, so all but the play button on the
        cover (#315) is left out of UI Automation. Each element is, not the grid: a button inside a left-out
        grid, once clicked or found by UI Automation, was an unhandled XAML error on every later resize of the
        window after its playlist had left the pane.
    -->
    <Grid
        Margin="0,4"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <FontIcon
                AutomationProperties.AccessibilityView="Raw"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <Image
                x:Name="CoverImage"
                AutomationProperties.AccessibilityView="Raw"
                Stretch="UniformToFill" />
            <!--
                Collapsed until the pointer is on the item. Not a tab stop: the item has the focus, and Play in
                its menu (#315).
            -->
            <Grid x:Name="PlayLayer" Visibility="Collapsed">
                <Button
                    x:Name="PlayButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Content"
                    Click="OnPlayClick"
                    CornerRadius="14"
                    DoubleTapped="OnPlayDoubleTapped"
                    IsTabStop="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Tapped="OnPlayTapped">
                    <FontIcon FontSize="12" Glyph="&#xE768;" />
                </Button>
            </Grid>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                AutomationProperties.AccessibilityView="Raw"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DetailsText"
                AutomationProperties.AccessibilityView="Raw"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
