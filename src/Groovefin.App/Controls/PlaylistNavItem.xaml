<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.PlaylistNavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        A favourite playlist in the expanded navigation pane (#299): its cover, then its name and below it the
        track count and length. The item itself carries the name for Narrator, so this is all decorative.
    -->
    <Grid
        Margin="0,4"
        AutomationProperties.AccessibilityView="Raw"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <FontIcon
                FontSize="16"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <Image x:Name="CoverImage" Stretch="UniformToFill" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DetailsText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
