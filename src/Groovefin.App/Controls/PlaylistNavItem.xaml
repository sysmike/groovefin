<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.PlaylistNavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        A favourite playlist in the expanded navigation pane (#299): its cover, then its name and below it the
        track count and length. The item itself carries the name for Narrator, so this is all decorative, but
        for the play button that fades in on the cover while the pointer is on the item (#315).
    -->
    <Grid
        Margin="0,4"
        AutomationProperties.AccessibilityView="Raw"
        ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <FontIcon
                FontSize="16"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <Image x:Name="CoverImage" Stretch="UniformToFill" />
            <!-- Not a tab stop: the item has the focus, and Play in its menu (#315). -->
            <Button
                x:Name="PlayButton"
                Width="28"
                Height="28"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Content"
                Click="OnPlayClick"
                CornerRadius="14"
                DoubleTapped="OnPlayDoubleTapped"
                IsHitTestVisible="False"
                IsTabStop="False"
                Opacity="0"
                Style="{StaticResource AccentButtonStyle}"
                Tapped="OnPlayTapped">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.083" />
                </Button.OpacityTransition>
                <FontIcon FontSize="12" Glyph="&#xE768;" />
            </Button>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DetailsText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
