<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.TrackNumber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        A track list's # cell: the number, or a speaker in the accent colour while the track plays (#247).
        The speaker is decorative: the row's name says which track it is.
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlayingStates">
                <VisualState x:Name="NotPlaying" />
                <VisualState x:Name="Playing">
                    <VisualState.Setters>
                        <Setter Target="NumberText.Visibility" Value="Collapsed" />
                        <Setter Target="PlayingIcon.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock
            x:Name="NumberText"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalTextAlignment="Right" />
        <FontIcon
            x:Name="PlayingIcon"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="12"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Glyph="&#xE995;"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
