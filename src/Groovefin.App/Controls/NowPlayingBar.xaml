<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Groovefin.Core.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="NowPlayingButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style
            x:Key="NowPlayingToggleStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--  A landmark (#51): Narrator can jump to the player. The x:Uid names it.  -->
    <controls:LandmarkGrid
        x:Uid="NowPlayingBar"
        Padding="16,8"
        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        AutomationProperties.AutomationId="NowPlaying"
        AutomationProperties.LandmarkType="Custom"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16">
        <!--
            The right column is as wide as its buttons and the volume slider (6 × 36 + 100 + spacing): narrower,
            the first buttons slid under the middle column and could be tabbed to but not seen (#51).
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="2*" MaxWidth="720" />
            <ColumnDefinition Width="*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!--  Cover, title (opens the album) and artists (links).  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="56"
                Height="56"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8D6;" />
                <Image
                    controls:Artwork.Request="{x:Bind ViewModel.Cover, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <HyperlinkButton
                    x:Uid="NowPlayingTitleLink"
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenAlbumCommand}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </HyperlinkButton>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistRef">
                            <HyperlinkButton
                                Padding="0"
                                Click="OnArtistClick"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="{x:Bind}">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>

        <!--  Transport and seek bar.  -->
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <ToggleButton
                    x:Uid="NowPlayingShuffleButton"
                    IsChecked="{x:Bind ViewModel.Shuffle, Mode=TwoWay}"
                    Style="{StaticResource NowPlayingToggleStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </ToggleButton>
                <Button
                    x:Uid="NowPlayingPreviousButton"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    Style="{StaticResource NowPlayingButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                </Button>
                <!--  The x:Uid only supplies the access key; the name follows the play state.  -->
                <Button
                    x:Name="PlayPauseButton"
                    x:Uid="NowPlayingPlayPauseButton"
                    Width="40"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayPauseName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseName, Mode=OneWay}"
                    Height="40"
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    CornerRadius="20"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="{x:Bind conv:Glyphs.PlayPause(ViewModel.IsPlaying), Mode=OneWay}" />
                </Button>
                <Button
                    x:Uid="NowPlayingNextButton"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Style="{StaticResource NowPlayingButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                </Button>
                <!--  Click cycles off → all → one; checked while repeat is on.  -->
                <ToggleButton
                    AutomationProperties.Name="{x:Bind ViewModel.RepeatName, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CycleRepeatCommand}"
                    IsChecked="{x:Bind ViewModel.IsRepeatOn, Mode=OneWay}"
                    Style="{StaticResource NowPlayingToggleStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RepeatName, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.Repeat(ViewModel.Repeat), Mode=OneWay}" />
                </ToggleButton>
            </StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalTextAlignment="Right"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                <Slider
                    x:Name="SeekSlider"
                    x:Uid="NowPlayingSeekSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="1"
                    LargeChange="30"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                    ValueChanged="OnSeekValueChanged" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                    TextWrapping="NoWrap" />
            </Grid>
        </StackPanel>

        <!--  Favourite, panels (as the features land), volume.  -->
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <ToggleButton
                x:Uid="NowPlayingFavouriteButton"
                Command="{x:Bind ViewModel.ToggleFavouriteCommand}"
                IsChecked="{x:Bind ViewModel.IsFavourite, Mode=OneWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.Heart(ViewModel.IsFavourite), Mode=OneWay}" />
            </ToggleButton>
            <ToggleButton
                x:Uid="NowPlayingQueueButton"
                IsChecked="{x:Bind Queue.IsOpen, Mode=TwoWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="&#xE90B;" />
            </ToggleButton>
            <ToggleButton
                x:Uid="NowPlayingLyricsButton"
                IsChecked="{x:Bind Lyrics.IsOpen, Mode=TwoWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="&#xE8D2;" />
            </ToggleButton>
            <ToggleButton
                x:Uid="NowPlayingMiniButton"
                IsChecked="{x:Bind ViewModel.IsMiniPlayer, Mode=TwoWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
            </ToggleButton>
            <ToggleButton
                x:Uid="NowPlayingFullScreenButton"
                IsChecked="{x:Bind ViewModel.IsFullScreen, Mode=TwoWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="&#xE740;" />
            </ToggleButton>
            <ToggleButton
                x:Uid="NowPlayingMuteButton"
                IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                Style="{StaticResource NowPlayingToggleStyle}">
                <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.Volume(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" />
            </ToggleButton>
            <Slider
                x:Uid="NowPlayingVolumeSlider"
                Width="100"
                VerticalAlignment="Center"
                Maximum="100"
                Minimum="0"
                SmallChange="5"
                StepFrequency="1"
                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
        </StackPanel>
    </controls:LandmarkGrid>
</UserControl>
