<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Groovefin.App.Controls.TrackText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        A track's title, artists or album in a track list; while the track plays it is drawn in the accent
        colour (#247, #249), the title with a speaker before it on rows without a # column. The states take
        the colours from the theme, so they follow light, dark and high contrast. The speaker is decorative:
        the row's name says which track it is. Its gap is a margin, not column spacing, which would stay
        while the speaker is collapsed and push the text off its column (#249).
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlayingStates">
                <VisualState x:Name="NotPlaying" />
                <VisualState x:Name="NotPlayingSecondary">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Playing">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PlayingWithIcon">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="PlayingIcon.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            x:Name="PlayingIcon"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="12"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Glyph="&#xE995;"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="Label"
            Grid.Column="1"
            VerticalAlignment="Center"
            MaxLines="1"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </Grid>
</UserControl>
