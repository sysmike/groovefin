<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Groovefin.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page layout, aligned with the Windows Settings app. -->
            <Thickness x:Key="PageContentMargin">36,24,36,36</Thickness>
            <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
            <x:Double x:Key="SearchBoxMaxWidth">480</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
