<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Groovefin.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page layout, aligned with the Windows Settings app. -->
            <Thickness x:Key="PageContentMargin">36,24,36,36</Thickness>
            <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
            <x:Double x:Key="SearchBoxMaxWidth">480</x:Double>

            <!--
                List density (standard values). ThemeService replaces them for the compact density;
                views use {ThemeResource} so a change applies at once.
            -->
            <x:Double x:Key="ListThumbnailSize">40</x:Double>
            <Thickness x:Key="ListRowPadding">0,4</Thickness>
            <Thickness x:Key="ListItemPadding">8,4</Thickness>
            <Thickness x:Key="TrackRowPadding">0,6</Thickness>
            <x:Double x:Key="TableRowHeight">36</x:Double>

            <!--  A table's column header that sorts on click (Songs, album tracks).  -->
            <Style
                x:Key="ColumnHeaderButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
