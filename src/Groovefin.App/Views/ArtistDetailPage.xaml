<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Groovefin.Core.Models"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  The albums grid's tiles grow until whole columns fill each row, as on the Albums page (#232, #263).  -->
        <controls:TileSize x:Key="AlbumTile" MinWidth="168" />

        <!--  Grid tile: square cover, name, year.  -->
        <DataTemplate x:Key="AlbumGridTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="{Binding Width, Source={StaticResource AlbumTile}}" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="{Binding Width, Source={StaticResource AlbumTile}}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play and the songs popup, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Year}" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  Shelf tile (appears on): square cover, name, year.  -->
        <DataTemplate x:Key="AlbumTileTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="152" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="152"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play and the songs popup, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Year}" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  The similar artists' tiles grow until whole columns fill their one row (#232, #264).  -->
        <controls:TileSize x:Key="SimilarTile" MinWidth="152" />

        <!--  Round image, name.  -->
        <DataTemplate x:Key="ArtistTileTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="{Binding Width, Source={StaticResource SimilarTile}}" Padding="0,0,0,8" Spacing="8">
                    <Grid
                        Width="{Binding Width, Source={StaticResource SimilarTile}}"
                        Height="{Binding Width, Source={StaticResource SimilarTile}}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{Binding Round, Source={StaticResource SimilarTile}}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <Style
            x:Key="SectionHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="36,24,36,8" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
    </Page.Resources>

    <ScrollViewer controls:ViewMemory.IsEnabled="True">
        <StackPanel Padding="0,0,0,36">
            <!--  Hero header: blurred image behind in-app acrylic, then round image, name and actions.  -->
            <Grid Visibility="{x:Bind ViewModel.HasArtist, Mode=OneWay}">
                <!--  As tall as the content (set in code): on its own it would take the image's aspect ratio (#146).  -->
                <Image
                    x:Name="HeaderBackground"
                    Height="0"
                    VerticalAlignment="Top"
                    controls:Artwork.Request="{x:Bind ViewModel.Background, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
                <Rectangle Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

                <!--
                    Top, not stretched: stretched to the header, which the background makes as tall as the
                    content was, it could grow (in a narrow window, the mini player) but never shrink (#218).
                -->
                <Grid
                    Padding="36,32,36,24"
                    VerticalAlignment="Top"
                    ColumnSpacing="28"
                    SizeChanged="OnHeaderContentSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="200"
                        Height="200"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="100">
                        <FontIcon
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind ViewModel.Image, Mode=OneWay}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <TextBlock
                            x:Uid="ArtistKind"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            MaxLines="2"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <!--  Genres, each a link to its page (#265).  -->
                        <ItemsRepeater
                            x:Uid="ArtistGenres"
                            ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasGenres, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:Genre">
                                    <HyperlinkButton
                                        Padding="4,2"
                                        Click="OnGenreClick"
                                        Content="{x:Bind Name}"
                                        Tag="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Uid="ArtistPlayButton"
                                AutomationProperties.AutomationId="ArtistPlayButton"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    <TextBlock x:Uid="ArtistPlayText" />
                                </StackPanel>
                            </Button>
                            <Button x:Uid="ArtistShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                            </Button>
                            <Button x:Uid="ArtistMixButton" Command="{x:Bind ViewModel.InstantMixCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE945;" />
                            </Button>
                            <ToggleButton
                                x:Uid="ArtistFavouriteButton"
                                Command="{x:Bind ViewModel.ToggleFavouriteCommand}"
                                IsChecked="{x:Bind ViewModel.IsFavourite, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.Heart(ViewModel.IsFavourite), Mode=OneWay}" />
                            </ToggleButton>

                            <!--  The artist on other sites (#194); they open in the browser.  -->
                            <HyperlinkButton
                                x:Uid="ArtistMusicBrainzLink"
                                Margin="12,0,0,0"
                                NavigateUri="{x:Bind ViewModel.MusicBrainzUrl, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasMusicBrainz, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:SiteIcon VerticalAlignment="Center" Site="MusicBrainz" />
                                    <TextBlock x:Uid="ArtistMusicBrainzLinkText" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton
                                x:Uid="ArtistLastFmLink"
                                NavigateUri="{x:Bind ViewModel.LastFmUrl, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasLastFm, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:SiteIcon VerticalAlignment="Center" Site="LastFm" />
                                    <TextBlock x:Uid="ArtistLastFmLinkText" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Collapsed when idle: an inactive ring still takes its space (#155, #200).  -->
            <ProgressRing
                x:Uid="LoadingRing"
                Margin="36,48"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                x:Uid="ArtistLoadFailed"
                Margin="36,24"
                Style="{StaticResource BodyTextBlockStyle}"
                Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

            <StackPanel Visibility="{x:Bind ViewModel.HasArtist, Mode=OneWay}">
                <!--  Biography: four lines, expandable.  -->
                <StackPanel Visibility="{x:Bind ViewModel.HasBiography, Mode=OneWay}">
                    <TextBlock x:Uid="ArtistBiographyHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        x:Name="BiographyText"
                        MaxWidth="880"
                        Margin="36,0"
                        HorizontalAlignment="Left"
                        IsTextSelectionEnabled="True"
                        MaxLines="4"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Biography, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Name="BiographyToggle"
                        x:Uid="ArtistBiographyMore"
                        Margin="28,4,0,0"
                        Click="OnBiographyToggleClick" />
                </StackPanel>

                <!--
                    Top tracks; a row plays the top tracks from there. As wide as the page, with the playlist
                    table's columns (#266): number, title, album, heart, length.
                -->
                <StackPanel Visibility="{x:Bind ViewModel.HasTopTracks, Mode=OneWay}">
                    <TextBlock x:Uid="ArtistTopTracksHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <ListView
                        controls:TrackDragSource.IsEnabled="True"
                        controls:ItemMenu.IsEnabled="True"
                        x:Uid="ArtistTopTracks"
                        AutomationProperties.AutomationId="ArtistTopTracks"
                        Padding="36,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnTopTrackClick"
                        ItemsSource="{x:Bind ViewModel.TopTracks}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtistTrackItem">
                                <Grid
                                    Padding="{ThemeResource TrackRowPadding}"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <controls:TrackNumber
                                        VerticalAlignment="Center"
                                        IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                        Text="{x:Bind Number}" />
                                    <controls:TrackText
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                        Text="{x:Bind Name}" />
                                    <controls:TrackText
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                        IsSecondary="True"
                                        Text="{x:Bind Album}" />
                                    <ToggleButton
                                        x:Uid="AlbumTrackFavouriteButton"
                                        Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderThickness="0"
                                        Click="OnTopTrackFavouriteClick"
                                        IsChecked="{x:Bind IsFavourite, Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="{x:Bind conv:Glyphs.Heart(IsFavourite), Mode=OneWay}" />
                                    </ToggleButton>
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalTextAlignment="Right"
                                        Text="{x:Bind Duration}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--
                    The artist's albums: a grid like the Albums page's, its rows filling the page's width (#263).
                    It grows with its rows and never scrolls itself; the page scrolls. Its layout creates every
                    tile, also below the visible part, so Tab reaches them. Arrow keys move between tiles, Tab
                    moves to the next section.
                -->
                <StackPanel Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                    <TextBlock x:Uid="ArtistAlbumsHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsView
                        controls:ItemMenu.IsEnabled="True"
                        x:Uid="ArtistAlbums"
                        controls:TileSize.Source="{StaticResource AlbumTile}"
                        AutomationProperties.AutomationId="ArtistAlbums"
                        Padding="36,0"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="OnAlbumInvoked"
                        ItemTemplate="{StaticResource AlbumGridTemplate}"
                        ItemsSource="{x:Bind ViewModel.Albums}"
                        Loaded="OnGridLoaded"
                        SelectionMode="None">
                        <ItemsView.Layout>
                            <controls:WrapGridLayout
                                MinColumnSpacing="16"
                                MinItemWidth="168"
                                MinRowSpacing="8" />
                        </ItemsView.Layout>
                    </ItemsView>
                </StackPanel>

                <!--  Appears on stays a shelf: compilations can be many, and the page goes on below.  -->
                <StackPanel Visibility="{x:Bind ViewModel.HasAppearsOn, Mode=OneWay}">
                    <TextBlock x:Uid="ArtistAppearsOnHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsView
                        controls:ItemMenu.IsEnabled="True"
                        x:Uid="ArtistAppearsOn"
                        Height="224"
                        Padding="36,0"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="OnAlbumInvoked"
                        ItemTemplate="{StaticResource AlbumTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.AppearsOn}"
                        Loaded="OnShelfLoaded"
                        SelectionMode="None">
                        <ItemsView.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsView.Layout>
                    </ItemsView>
                </StackPanel>

                <!--
                    Similar artists: one row of as many as fit the width, no sideways scrolling (#264). The row
                    reports its columns to the view model, which shows that many of the loaded artists.
                -->
                <StackPanel Visibility="{x:Bind ViewModel.HasSimilar, Mode=OneWay}">
                    <TextBlock x:Uid="ArtistSimilarHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsView
                        controls:ItemMenu.IsEnabled="True"
                        x:Uid="ArtistSimilar"
                        controls:TileSize.Source="{StaticResource SimilarTile}"
                        AutomationProperties.AutomationId="ArtistSimilar"
                        Padding="36,0"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="OnArtistInvoked"
                        ItemTemplate="{StaticResource ArtistTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.SimilarRow}"
                        Loaded="OnGridLoaded"
                        SelectionMode="None"
                        SizeChanged="OnSimilarSizeChanged">
                        <ItemsView.Layout>
                            <controls:WrapGridLayout
                                MinColumnSpacing="16"
                                MinItemWidth="152"
                                MinRowSpacing="8" />
                        </ItemsView.Layout>
                    </ItemsView>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
