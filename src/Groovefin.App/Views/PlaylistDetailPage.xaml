<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: image, name, details and actions.  -->
        <Grid
            Padding="36,32,36,16"
            ColumnSpacing="28"
            Visibility="{x:Bind ViewModel.HasPlaylist, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="200"
                Height="200"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <FontIcon
                    FontSize="56"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8FD;" />
                <Image
                    controls:Artwork.Request="{x:Bind ViewModel.Image, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="8">
                <TextBlock
                    x:Uid="PlaylistKind"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    MaxLines="2"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Details, Mode=OneWay}" />

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="PlaylistPlayButton"
                        Command="{x:Bind ViewModel.PlayCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="PlaylistPlayText" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="PlaylistShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                    </Button>
                    <Button x:Uid="PlaylistQueueButton" Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button x:Uid="PlaylistRenameButton" Command="{x:Bind ViewModel.RenameCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                    </Button>
                    <Button x:Uid="PlaylistDeleteButton" Command="{x:Bind ViewModel.DeleteCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ProgressRing
            x:Uid="LoadingRing"
            Grid.RowSpan="2"
            Margin="36,48"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock
            x:Uid="PlaylistLoadFailed"
            Grid.RowSpan="2"
            Margin="36,48"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

        <!--  Entries: click plays from there, drag reorders, the context menu (or Shift+F10) moves and removes.  -->
        <ListView
            controls:TrackDragSource.IsEnabled="True"
            x:Name="EntriesList"
            x:Uid="PlaylistEntries"
            Grid.Row="1"
            Padding="24,0,24,24"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            ContextRequested="OnEntryContextRequested"
            DragItemsCompleted="OnEntriesDragCompleted"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistEntryItem">
                    <Grid
                        Padding="{ThemeResource ListRowPadding}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="{ThemeResource ListThumbnailSize}"
                            Height="{ThemeResource ListThumbnailSize}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Image
                                controls:Artwork.Request="{x:Bind Cover}"
                                AutomationProperties.AccessibilityView="Raw"
                                Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Uid="PlaylistEmpty"
            Grid.Row="1"
            Margin="36,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
