<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: image, name, details and actions.  -->
        <Grid
            Padding="36,32,36,16"
            ColumnSpacing="28"
            Visibility="{x:Bind ViewModel.HasPlaylist, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="200"
                Height="200"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <FontIcon
                    FontSize="56"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8FD;" />
                <Image
                    controls:Artwork.Request="{x:Bind ViewModel.Image, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="8">
                <TextBlock
                    x:Uid="PlaylistKind"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    MaxLines="2"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Details, Mode=OneWay}" />

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="PlaylistPlayButton"
                        Command="{x:Bind ViewModel.PlayCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="PlaylistPlayText" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="PlaylistShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                    </Button>
                    <Button x:Uid="PlaylistQueueButton" Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button x:Uid="PlaylistRenameButton" Command="{x:Bind ViewModel.RenameCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                    </Button>
                    <Button x:Uid="PlaylistDeleteButton" Command="{x:Bind ViewModel.DeleteCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ProgressRing
            x:Uid="LoadingRing"
            Grid.RowSpan="3"
            Margin="36,48"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock
            x:Uid="PlaylistLoadFailed"
            Grid.RowSpan="3"
            Margin="36,48"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

        <!--
            Column headers like the album page's (#245): a 36 px row of semibold labels with a divider below and a
            thin line after each column, with the same insets (16 left, 12 right inside the list items). They do not
            sort: the playlist's own order counts, which dragging and the context menu change.
        -->
        <Grid
            Grid.Row="1"
            Height="36"
            Margin="52,0,48,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
            <Grid.Resources>
                <Style x:Key="ColumnDividerStyle" TargetType="Rectangle">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="0,8,-8,8" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Style>
                <Style
                    x:Key="ColumnLabelStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="2" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="3" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="4" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="5" Style="{StaticResource ColumnDividerStyle}" />
            <TextBlock
                x:Uid="AlbumColumnNumber"
                Grid.Column="0"
                HorizontalTextAlignment="Right"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="AlbumColumnTitle"
                Grid.Column="1"
                AutomationProperties.AutomationId="PlaylistColumnTitle"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="PlaylistColumnArtist"
                Grid.Column="2"
                AutomationProperties.AutomationId="PlaylistColumnArtist"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="PlaylistColumnAlbum"
                Grid.Column="3"
                AutomationProperties.AutomationId="PlaylistColumnAlbum"
                Style="{StaticResource ColumnLabelStyle}" />
            <FontIcon
                Grid.Column="4"
                FontSize="12"
                Glyph="&#xEB51;" />
            <FontIcon
                Grid.Column="5"
                HorizontalAlignment="Right"
                FontSize="12"
                Glyph="&#xE823;" />
        </Grid>

        <!--  Entries: click plays from there, drag reorders, the context menu (or Shift+F10) moves and removes.  -->
        <ListView
            controls:TrackDragSource.IsEnabled="True"
            x:Name="EntriesList"
            x:Uid="PlaylistEntries"
            Grid.Row="2"
            Padding="36,0,36,24"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            ContextRequested="OnEntryContextRequested"
            DragItemsCompleted="OnEntriesDragCompleted"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistEntryItem">
                    <Grid
                        Padding="{ThemeResource TrackRowPadding}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalTextAlignment="Right"
                            Text="{x:Bind Number, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Album}"
                            TextTrimming="CharacterEllipsis" />
                        <ToggleButton
                            x:Uid="AlbumTrackFavouriteButton"
                            Grid.Column="4"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderThickness="0"
                            Click="OnEntryFavouriteClick"
                            IsChecked="{x:Bind IsFavourite, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="{x:Bind conv:Glyphs.Heart(IsFavourite), Mode=OneWay}" />
                        </ToggleButton>
                        <TextBlock
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalTextAlignment="Right"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Uid="PlaylistEmpty"
            Grid.Row="2"
            Margin="36,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
