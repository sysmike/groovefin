<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Groovefin.Core.Models"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="36,24,36,8"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                x:Uid="FoldersHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing
                x:Uid="LoadingRing"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <!--  The path from the top, and what can be done with the open folder.  -->
        <Grid
            Grid.Row="1"
            Margin="36,0,36,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
                No item template: BreadcrumbBar also realizes an ellipsis item without data, which a typed
                x:Bind template cannot cast (#144). The bar shows FolderCrumb.ToString(), the folder name.
            -->
            <BreadcrumbBar
                x:Uid="FoldersPath"
                VerticalAlignment="Center"
                ItemClicked="OnCrumbClicked"
                ItemsSource="{x:Bind ViewModel.Path}" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Uid="FoldersUpButton" Command="{x:Bind ViewModel.GoUpCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button
                    x:Uid="FoldersPlayButton"
                    Command="{x:Bind ViewModel.PlayCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="FoldersPlayText" />
                    </StackPanel>
                </Button>
                <Button x:Uid="FoldersQueueButton" Command="{x:Bind ViewModel.AddToQueueCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="FoldersQueueText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="0,0,0,36">
                <TextBlock
                    x:Uid="FoldersEmpty"
                    Margin="36,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                <TextBlock
                    x:Uid="FoldersLoadFailed"
                    Margin="36,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

                <!--  Subfolders: click opens, the context menu plays or queues them with everything inside.  -->
                <ListView
                    x:Uid="FoldersList"
                    MaxWidth="880"
                    Margin="24,0"
                    HorizontalAlignment="Left"
                    controls:ItemMenu.IsEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="OnFolderClick"
                    ItemsSource="{x:Bind ViewModel.Folders}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Folder">
                            <Grid
                                Padding="{ThemeResource ListRowPadding}"
                                AutomationProperties.Name="{x:Bind Name}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Width="{ThemeResource ListThumbnailSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  The folder's own tracks: click plays from there.  -->
                <ListView
                    x:Uid="FoldersTracks"
                    MaxWidth="880"
                    Margin="24,0"
                    HorizontalAlignment="Left"
                    controls:ItemMenu.IsEnabled="True"
                    controls:TrackDragSource.IsEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="OnTrackClick"
                    ItemsSource="{x:Bind ViewModel.Tracks}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasTracks, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackRow">
                            <Grid
                                Padding="{ThemeResource ListRowPadding}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="{ThemeResource ListThumbnailSize}"
                                    Height="{ThemeResource ListThumbnailSize}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Image
                                        controls:Artwork.Request="{x:Bind Cover}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Duration}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
