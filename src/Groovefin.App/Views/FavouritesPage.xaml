<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.FavouritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Grid: square cover, name, artist.  -->
        <DataTemplate x:Key="AlbumGridTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="168" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="168"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  Round image, name.  -->
        <DataTemplate x:Key="ArtistTileTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="168" Padding="0,0,0,8" Spacing="8">
                    <Grid
                        Width="168"
                        Height="168"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="84">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="FavouritesHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="FavouritesPlayButton"
                    Command="{x:Bind ViewModel.PlayAllCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="FavouritesPlayText" />
                    </StackPanel>
                </Button>
                <Button x:Uid="FavouritesShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar
            Grid.Row="1"
            Margin="24,0"
            SelectionChanged="OnSectionChanged">
            <SelectorBarItem x:Name="SongsSection" x:Uid="FavouritesSongsTab" IsSelected="True" />
            <SelectorBarItem x:Name="AlbumsSection" x:Uid="FavouritesAlbumsTab" />
            <SelectorBarItem x:Name="ArtistsSection" x:Uid="FavouritesArtistsTab" />
        </SelectorBar>

        <Grid Grid.Row="2" Padding="0,8,0,0">
            <!--  Songs: click plays from there; the heart removes the song from the favourites.  -->
            <ListView
                controls:TrackDragSource.IsEnabled="True"
                controls:ItemMenu.IsEnabled="True"
                x:Name="SongsList"
                x:Uid="FavouritesSongs"
                Padding="24,0,24,24"
                IsItemClickEnabled="True"
                ItemClick="OnTrackClick"
                ItemsSource="{x:Bind ViewModel.Tracks}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FavouriteTrackItem">
                        <Grid
                            Padding="{ThemeResource ListRowPadding}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="{ThemeResource ListThumbnailSize}"
                                Height="{ThemeResource ListThumbnailSize}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Image
                                    controls:Artwork.Request="{x:Bind Cover}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Details}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Uid="FavouritesRemoveButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                BorderThickness="0"
                                Click="OnUnfavouriteClick">
                                <FontIcon FontSize="12" Glyph="&#xEB52;" />
                            </Button>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Duration}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ItemsView
                controls:ItemMenu.IsEnabled="True"
                x:Name="AlbumsView"
                x:Uid="FavouritesAlbums"
                Padding="36,0,36,24"
                IsItemInvokedEnabled="True"
                ItemInvoked="OnAlbumInvoked"
                ItemTemplate="{StaticResource AlbumGridTemplate}"
                ItemsSource="{x:Bind ViewModel.Albums}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="16"
                        MinItemWidth="168"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
            </ItemsView>

            <ItemsView
                controls:ItemMenu.IsEnabled="True"
                x:Name="ArtistsView"
                x:Uid="FavouritesArtists"
                Padding="36,0,36,24"
                IsItemInvokedEnabled="True"
                ItemInvoked="OnArtistInvoked"
                ItemTemplate="{StaticResource ArtistTileTemplate}"
                ItemsSource="{x:Bind ViewModel.Artists}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="16"
                        MinItemWidth="168"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
            </ItemsView>

            <TextBlock
                x:Name="EmptyText"
                Margin="36,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
