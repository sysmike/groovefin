<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.FavouritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  The grids' tiles grow until whole columns fill each row (#232); one size per grid.  -->
        <controls:TileSize x:Key="FavouriteAlbumTile" MinWidth="168" />
        <controls:TileSize x:Key="FavouriteArtistTile" MinWidth="168" />

        <!--  Grid: square cover, name, artist.  -->
        <DataTemplate x:Key="AlbumGridTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="{Binding Width, Source={StaticResource FavouriteAlbumTile}}" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="{Binding Width, Source={StaticResource FavouriteAlbumTile}}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play and the songs popup, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <!--  A mark when it is downloaded with every song (#337).  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            x:Uid="DownloadedIcon"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE896;"
                            Visibility="{x:Bind IsDownloaded}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  Round image, name.  -->
        <DataTemplate x:Key="ArtistTileTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="{Binding Width, Source={StaticResource FavouriteArtistTile}}" Padding="0,0,0,8" Spacing="8">
                    <Grid
                        Width="{Binding Width, Source={StaticResource FavouriteArtistTile}}"
                        Height="{Binding Width, Source={StaticResource FavouriteArtistTile}}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{Binding Round, Source={StaticResource FavouriteArtistTile}}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <!--  A mark when it is downloaded with every song (#337).  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            x:Uid="DownloadedIcon"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE896;"
                            Visibility="{x:Bind IsDownloaded}" />
                    </Grid>
                </StackPanel>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="FavouritesHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing
                    x:Uid="LoadingRing"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="FavouritesPlayButton"
                    Command="{x:Bind ViewModel.PlayAllCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="FavouritesPlayText" />
                    </StackPanel>
                </Button>
                <Button x:Uid="FavouritesShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar
            controls:ViewMemory.IsEnabled="True"
            x:Name="Sections"
            Grid.Row="1"
            Margin="24,0"
            SelectionChanged="OnSectionChanged">
            <SelectorBarItem
                x:Name="SongsSection"
                x:Uid="FavouritesSongsTab"
                AutomationProperties.AutomationId="FavouritesSongsTab"
                IsSelected="True" />
            <SelectorBarItem
                x:Name="AlbumsSection"
                x:Uid="FavouritesAlbumsTab"
                AutomationProperties.AutomationId="FavouritesAlbumsTab" />
            <SelectorBarItem
                x:Name="ArtistsSection"
                x:Uid="FavouritesArtistsTab"
                AutomationProperties.AutomationId="FavouritesArtistsTab" />
        </SelectorBar>

        <Grid Grid.Row="2" Padding="0,8,0,0">
            <!--
                Songs: a table like a playlist's (#359), with the same column headers (#245) and the album's cover
                before the title (#262). Click plays from there; the heart removes the song from the favourites.
            -->
            <Grid x:Name="SongsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Height="36"
                    Margin="52,0,48,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="16">
                    <Grid.Resources>
                        <Style x:Key="ColumnDividerStyle" TargetType="Rectangle">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Margin" Value="0,8,-8,8" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Style>
                        <Style
                            x:Key="ColumnLabelStyle"
                            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                            TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Style="{StaticResource ColumnDividerStyle}" />
                    <Rectangle Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />
                    <Rectangle Grid.Column="2" Style="{StaticResource ColumnDividerStyle}" />
                    <Rectangle Grid.Column="3" Style="{StaticResource ColumnDividerStyle}" />
                    <!--  The rows show the album's cover before the title: the label starts where the title does.  -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="{ThemeResource ListThumbnailSize}" />
                        <TextBlock
                            x:Uid="AlbumColumnTitle"
                            AutomationProperties.AutomationId="FavouritesColumnTitle"
                            Style="{StaticResource ColumnLabelStyle}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="PlaylistColumnArtist"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="FavouritesColumnArtist"
                        Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock
                        x:Uid="PlaylistColumnAlbum"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="FavouritesColumnAlbum"
                        Style="{StaticResource ColumnLabelStyle}" />
                    <FontIcon
                        Grid.Column="3"
                        FontSize="12"
                        Glyph="&#xEB51;" />
                    <FontIcon
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Glyph="&#xE823;" />
                </Grid>

                <ListView
                    controls:ViewMemory.IsEnabled="True"
                    controls:TrackDragSource.IsEnabled="True"
                    controls:ItemMenu.IsEnabled="True"
                    controls:TrackSelection.IsEnabled="True"
                    x:Name="SongsList"
                    x:Uid="FavouritesSongs"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="FavouritesSongs"
                    Padding="36,0,36,24"
                    IsItemClickEnabled="True"
                    ItemClick="OnTrackClick"
                    ItemsSource="{x:Bind ViewModel.Tracks}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FavouriteTrackItem">
                            <Grid
                                Padding="{ThemeResource TrackRowPadding}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <!--  The album's cover, then the title. Decorative: the row's name says it all.  -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="{ThemeResource ListThumbnailSize}"
                                        Height="{ThemeResource ListThumbnailSize}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE93C;" />
                                        <Image
                                            controls:Artwork.Request="{x:Bind Cover}"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                    <!--  No track number: the speaker shows before the title while it plays.  -->
                                    <controls:TrackText
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsDownloaded="{x:Bind IsDownloaded, Mode=OneWay}"
                                        IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                        ShowsIcon="True"
                                        Text="{x:Bind Name}" />
                                </Grid>
                                <controls:TrackText
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                    IsSecondary="True"
                                    Text="{x:Bind Artist}" />
                                <controls:TrackText
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                                    IsSecondary="True"
                                    Text="{x:Bind Album}" />
                                <Button
                                    x:Uid="FavouritesRemoveButton"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderThickness="0"
                                    Click="OnUnfavouriteClick">
                                    <FontIcon FontSize="12" Glyph="&#xEB52;" />
                                </Button>
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalTextAlignment="Right"
                                    Text="{x:Bind Duration}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ItemsView
                controls:ViewMemory.IsEnabled="True"
                controls:ItemMenu.IsEnabled="True"
                x:Name="AlbumsView"
                x:Uid="FavouritesAlbums"
                controls:TileSize.Source="{StaticResource FavouriteAlbumTile}"
                Padding="36,0,36,24"
                IsItemInvokedEnabled="True"
                ItemInvoked="OnAlbumInvoked"
                ItemTemplate="{StaticResource AlbumGridTemplate}"
                ItemsSource="{x:Bind ViewModel.Albums}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="16"
                        MinItemWidth="168"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
            </ItemsView>

            <ItemsView
                controls:ViewMemory.IsEnabled="True"
                controls:ItemMenu.IsEnabled="True"
                x:Name="ArtistsView"
                x:Uid="FavouritesArtists"
                controls:TileSize.Source="{StaticResource FavouriteArtistTile}"
                Padding="36,0,36,24"
                IsItemInvokedEnabled="True"
                ItemInvoked="OnArtistInvoked"
                ItemTemplate="{StaticResource ArtistTileTemplate}"
                ItemsSource="{x:Bind ViewModel.Artists}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="16"
                        MinItemWidth="168"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
            </ItemsView>

            <TextBlock
                x:Name="EmptyText"
                Margin="36,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
