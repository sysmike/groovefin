<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.GenreDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Square cover, name, album artist.  -->
        <DataTemplate x:Key="AlbumTileTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="152" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="152"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play and the songs popup, on hover (#185, #189).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <Style
            x:Key="SectionHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="36,24,36,8" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="0,0,0,36">
            <!--  Header: name and actions.  -->
            <StackPanel
                Padding="36,32,36,0"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasGenre, Mode=OneWay}">
                <TextBlock
                    x:Uid="GenreKind"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="GenrePlayButton"
                        Command="{x:Bind ViewModel.PlayCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="GenrePlayText" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="GenreShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                    </Button>
                    <Button x:Uid="GenreMixButton" Command="{x:Bind ViewModel.InstantMixCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE945;" />
                            <TextBlock x:Uid="GenreMixText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  Collapsed when idle: an inactive ring still takes its space (#155, #200).  -->
            <ProgressRing
                x:Uid="LoadingRing"
                Margin="36,48"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                x:Uid="GenreLoadFailed"
                Margin="36,48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

            <!--  Albums as a shelf: arrow keys move between them, Tab moves on to the songs.  -->
            <StackPanel Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                <TextBlock x:Uid="GenreAlbumsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsView
                    x:Uid="GenreAlbums"
                    Height="224"
                    Padding="36,0"
                    controls:ItemMenu.IsEnabled="True"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="OnAlbumInvoked"
                    ItemTemplate="{StaticResource AlbumTileTemplate}"
                    ItemsSource="{x:Bind ViewModel.Albums}"
                    Loaded="OnShelfLoaded"
                    SelectionMode="None">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16" />
                    </ItemsView.Layout>
                </ItemsView>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasTracks, Mode=OneWay}">
                <TextBlock x:Uid="GenreSongsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView
                    controls:TrackDragSource.IsEnabled="True"
                    x:Uid="GenreSongs"
                    MaxWidth="880"
                    Margin="24,0"
                    HorizontalAlignment="Left"
                    controls:ItemMenu.IsEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="OnTrackClick"
                    ItemsSource="{x:Bind ViewModel.Tracks}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackRow">
                            <Grid
                                Padding="{ThemeResource ListRowPadding}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="{ThemeResource ListThumbnailSize}"
                                    Height="{ThemeResource ListThumbnailSize}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Image
                                        controls:Artwork.Request="{x:Bind Cover}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Duration}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
