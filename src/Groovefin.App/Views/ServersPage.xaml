<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <!--
            A Grid between the ScrollViewer and the content of limited width: the ScrollViewer places
            content smaller than its view by the width the content asks for, not the width it gets, so a
            page with only short lines sat to the right (#347). The Grid takes the whole width and
            centres the content.
        -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource PageContentMaxWidth}"
                Margin="{StaticResource PageContentMargin}"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock
                    x:Uid="ServersHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="ServersIntro"
                    AutomationProperties.AutomationId="ServersIntro"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasFormError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.FormError, Mode=OneWay}"
                    Severity="Error" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="AddressBox"
                        x:Uid="ServerAddressBox"
                        InputScope="Url"
                        KeyDown="OnAddressKeyDown"
                        Text="{x:Bind ViewModel.NewAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Uid="ServerAddButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        x:Uid="ServerConnectingRing"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Bottom"
                        IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
                </Grid>

                <!--  A slow connection says what it is doing, and can be cancelled (#392).  -->
                <Grid
                    Margin="0,-8,0,0"
                    ColumnSpacing="12"
                    Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ServerAttempt"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.AttemptText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="ServerCancelButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ServerCancelButton"
                        Command="{x:Bind ViewModel.CancelConnectCommand}" />
                </Grid>

                <!--  Servers found on the local network (#405): searched when the page opens.  -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="ServersFoundHeader"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button
                        x:Uid="ServersSearchAgainButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ServersSearchAgainButton"
                        Command="{x:Bind ViewModel.DiscoverCommand}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <ProgressRing
                        x:Uid="ServersSearchingRing"
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.DiscoverCommand.IsRunning, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    x:Uid="ServersNoneFound"
                    Margin="0,-8,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Visibility="{x:Bind ViewModel.NoneDiscovered, Mode=OneWay}" />
                <ListView
                    x:Uid="ServerFoundList"
                    Margin="0,-8,0,0"
                    AutomationProperties.AutomationId="ServerFoundList"
                    ItemsSource="{x:Bind ViewModel.Discovered}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasDiscovered, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiscoveredServerItem">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE968;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Address}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Visibility="{x:Bind IsUnencrypted}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock
                                            x:Uid="ServerUnencryptedBadge"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    x:Uid="ServerAddFoundButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind AddName}"
                                    Click="OnAddFoundClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Uid="ServersListHeader"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Visibility="{x:Bind ViewModel.HasServers, Mode=OneWay}" />

                <ListView
                    x:Uid="ServerList"
                    AutomationProperties.AutomationId="ServerList"
                    ItemsSource="{x:Bind ViewModel.Servers}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItem">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind Name}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE968;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            x:Uid="ServerActiveBadge"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Visibility="{x:Bind IsActive}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Address}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Visibility="{x:Bind IsUnencrypted}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock
                                            x:Uid="ServerUnencryptedBadge"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Version}"
                                        Visibility="{x:Bind conv:Visible.WhenText(Version)}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        x:Uid="ServerMakeActiveButton"
                                        Click="OnMakeActiveClick"
                                        Visibility="{x:Bind conv:Visible.Unless(IsActive)}" />
                                    <Button
                                        x:Uid="ServerEditButton"
                                        Click="OnEditClick"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        x:Uid="ServerRemoveButton"
                                        Click="OnRemoveClick"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
