<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                x:Uid="ServersHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="ServersIntro"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasFormError, Mode=OneWay}"
                Message="{x:Bind ViewModel.FormError, Mode=OneWay}"
                Severity="Error" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="AddressBox"
                    x:Uid="ServerAddressBox"
                    InputScope="Url"
                    KeyDown="OnAddressKeyDown"
                    Text="{x:Bind ViewModel.NewAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="ServerAddButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.AddCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Bottom"
                    IsActive="{x:Bind ViewModel.AddCommand.IsRunning, Mode=OneWay}" />
            </Grid>

            <TextBlock
                x:Uid="ServersListHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Visibility="{x:Bind ViewModel.HasServers, Mode=OneWay}" />

            <ListView
                x:Uid="ServerList"
                ItemsSource="{x:Bind ViewModel.Servers}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServerItem">
                        <Grid
                            Padding="0,8"
                            AutomationProperties.Name="{x:Bind Name}"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE968;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock
                                        x:Uid="ServerActiveBadge"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind IsActive}" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Address}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Version}"
                                    Visibility="{x:Bind conv:Visible.WhenText(Version)}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    x:Uid="ServerMakeActiveButton"
                                    Click="OnMakeActiveClick"
                                    Visibility="{x:Bind conv:Visible.Unless(IsActive)}" />
                                <Button
                                    x:Uid="ServerEditButton"
                                    Click="OnEditClick"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                </Button>
                                <Button
                                    x:Uid="ServerRemoveButton"
                                    Click="OnRemoveClick"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
