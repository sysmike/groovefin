<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                x:Uid="SettingsHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Uid="SettingsAppearanceHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons
                x:Name="ThemeRadioButtons"
                x:Uid="SettingsTheme"
                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                <RadioButton x:Uid="SettingsThemeSystem" />
                <RadioButton x:Uid="SettingsThemeLight" />
                <RadioButton x:Uid="SettingsThemeDark" />
            </RadioButtons>

            <TextBlock
                x:Uid="SettingsAccountHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.UserName}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ServerName}" />
                </StackPanel>
                <Button
                    x:Uid="SettingsSignOutButton"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SignOutCommand}" />
            </StackPanel>

            <TextBlock
                x:Uid="SettingsServersHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Uid="SettingsManageServersButton" Command="{x:Bind ViewModel.ManageServersCommand}" />
            <!--  Only shown when the server has more than one music library.  -->
            <ComboBox
                x:Uid="SettingsLibraryBox"
                MinWidth="260"
                ItemsSource="{x:Bind ViewModel.Libraries}"
                SelectedIndex="{x:Bind ViewModel.SelectedLibraryIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasLibraryChoice, Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryOption">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock
                x:Uid="SettingsStreamingHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                x:Uid="SettingsStreamingIntro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox
                x:Uid="SettingsLocalBitrateBox"
                MinWidth="260"
                ItemsSource="{x:Bind ViewModel.BitrateOptions}"
                SelectedIndex="{x:Bind ViewModel.LocalBitrateIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BitrateOption">
                        <TextBlock Text="{x:Bind Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                x:Uid="SettingsRemoteBitrateBox"
                MinWidth="260"
                ItemsSource="{x:Bind ViewModel.BitrateOptions}"
                SelectedIndex="{x:Bind ViewModel.RemoteBitrateIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BitrateOption">
                        <TextBlock Text="{x:Bind Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                x:Uid="SettingsCodecBox"
                MinWidth="260"
                SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="SettingsCodecAac" />
                <ComboBoxItem x:Uid="SettingsCodecMp3" />
            </ComboBox>

            <TextBlock
                x:Uid="SettingsPlaybackHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox
                x:Uid="SettingsNormalizationBox"
                MinWidth="260"
                SelectedIndex="{x:Bind ViewModel.NormalizationIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="SettingsNormalizationOff" />
                <ComboBoxItem x:Uid="SettingsNormalizationTrack" />
                <ComboBoxItem x:Uid="SettingsNormalizationAlbum" />
            </ComboBox>
            <TextBlock
                x:Uid="SettingsNormalizationHint"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <ComboBox
                x:Uid="SettingsInstantMixBox"
                MinWidth="260"
                SelectedIndex="{x:Bind ViewModel.InstantMixIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="SettingsInstantMixReplace" />
                <ComboBoxItem x:Uid="SettingsInstantMixAppend" />
            </ComboBox>

            <TextBlock
                x:Uid="SettingsAboutHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsAppName" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Version.DisplayText}" />
                <TextBlock
                    x:Uid="SettingsLicense"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
