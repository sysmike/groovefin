<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                x:Uid="SettingsHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Uid="SettingsAppearanceHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons
                x:Name="ThemeRadioButtons"
                x:Uid="SettingsTheme"
                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                <RadioButton x:Uid="SettingsThemeSystem" />
                <RadioButton x:Uid="SettingsThemeLight" />
                <RadioButton x:Uid="SettingsThemeDark" />
            </RadioButtons>

            <TextBlock
                x:Uid="SettingsAboutHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsAppName" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Version.DisplayText}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
