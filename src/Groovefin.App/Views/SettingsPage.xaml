<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:about="using:Groovefin.Core.About"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Group headers like in Windows Settings: some space above, little below.  -->
        <Style
            x:Key="SettingsSectionHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,28,0,4" />
        </Style>
        <x:Double x:Key="SettingsChoiceMinWidth">220</x:Double>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                x:Uid="SettingsHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <!--  Appearance  -->
            <TextBlock
                x:Uid="SettingsAppearanceHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="SettingsThemeCard" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                <ComboBox MinWidth="{StaticResource SettingsChoiceMinWidth}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="SettingsThemeSystem" />
                    <ComboBoxItem x:Uid="SettingsThemeLight" />
                    <ComboBoxItem x:Uid="SettingsThemeDark" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsAccentCard" HeaderIcon="{ui:FontIcon Glyph=&#xE771;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.UseAccentColor, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsDensityCard" HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}">
                <ComboBox MinWidth="{StaticResource SettingsChoiceMinWidth}" SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="SettingsDensityStandard" />
                    <ComboBoxItem x:Uid="SettingsDensityCompact" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsLanguageCard" HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                <ComboBox
                    MinWidth="{StaticResource SettingsChoiceMinWidth}"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                    SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsStartPageCard" HeaderIcon="{ui:FontIcon Glyph=&#xE80F;}">
                <ComboBox
                    MinWidth="{StaticResource SettingsChoiceMinWidth}"
                    ItemsSource="{x:Bind ViewModel.StartPageOptions}"
                    SelectedIndex="{x:Bind ViewModel.StartPageIndex, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsTaskbarProgressCard" HeaderIcon="{ui:FontIcon Glyph=&#xE7C4;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTaskbarProgress, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsExpander x:Uid="SettingsTrayCard" HeaderIcon="{ui:FontIcon Glyph=&#xE7E7;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTrayIcon, Mode=TwoWay}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="SettingsMinimizeToTrayCard" IsEnabled="{x:Bind ViewModel.ShowTrayIcon, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  Account and servers  -->
            <TextBlock
                x:Uid="SettingsAccountHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard
                Description="{x:Bind ViewModel.ServerName}"
                Header="{x:Bind ViewModel.UserName}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE77B;}">
                <Button x:Uid="SettingsSignOutButton" Command="{x:Bind ViewModel.SignOutCommand}" />
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="SettingsServersCard"
                Command="{x:Bind ViewModel.ManageServersCommand}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE968;}"
                IsClickEnabled="True" />
            <!--  Only shown when the server has more than one music library.  -->
            <controls:SettingsCard
                x:Uid="SettingsLibraryCard"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}"
                Visibility="{x:Bind ViewModel.HasLibraryChoice, Mode=OneWay}">
                <ComboBox
                    MinWidth="{StaticResource SettingsChoiceMinWidth}"
                    ItemsSource="{x:Bind ViewModel.Libraries}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLibraryIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryOption">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingsCard>

            <!--  Streaming  -->
            <TextBlock
                x:Uid="SettingsStreamingHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsExpander
                x:Uid="SettingsStreamingCard"
                HeaderIcon="{ui:FontIcon Glyph=&#xE93E;}"
                IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="SettingsLocalBitrateCard">
                        <ComboBox
                            MinWidth="{StaticResource SettingsChoiceMinWidth}"
                            ItemsSource="{x:Bind ViewModel.BitrateOptions}"
                            SelectedIndex="{x:Bind ViewModel.LocalBitrateIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BitrateOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsRemoteBitrateCard">
                        <ComboBox
                            MinWidth="{StaticResource SettingsChoiceMinWidth}"
                            ItemsSource="{x:Bind ViewModel.BitrateOptions}"
                            SelectedIndex="{x:Bind ViewModel.RemoteBitrateIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BitrateOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsCodecCard">
                        <ComboBox MinWidth="{StaticResource SettingsChoiceMinWidth}" SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsCodecAac" />
                            <ComboBoxItem x:Uid="SettingsCodecMp3" />
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  Playback  -->
            <TextBlock
                x:Uid="SettingsPlaybackHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="SettingsNormalizationCard" HeaderIcon="{ui:FontIcon Glyph=&#xE995;}">
                <ComboBox MinWidth="{StaticResource SettingsChoiceMinWidth}" SelectedIndex="{x:Bind ViewModel.NormalizationIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="SettingsNormalizationOff" />
                    <ComboBoxItem x:Uid="SettingsNormalizationTrack" />
                    <ComboBoxItem x:Uid="SettingsNormalizationAlbum" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsInstantMixCard" HeaderIcon="{ui:FontIcon Glyph=&#xE8B1;}">
                <ComboBox MinWidth="{StaticResource SettingsChoiceMinWidth}" SelectedIndex="{x:Bind ViewModel.InstantMixIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="SettingsInstantMixReplace" />
                    <ComboBoxItem x:Uid="SettingsInstantMixAppend" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsCrossfadeCard" HeaderIcon="{ui:FontIcon Glyph=&#xE8AB;}">
                <ComboBox
                    MinWidth="{StaticResource SettingsChoiceMinWidth}"
                    ItemsSource="{x:Bind ViewModel.CrossfadeOptions}"
                    SelectedIndex="{x:Bind ViewModel.CrossfadeIndex, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsResumeCard" HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ResumeSession, Mode=TwoWay}" />
            </controls:SettingsCard>
            <!--  Hidden in a build without the Discord application ID.  -->
            <controls:SettingsCard
                x:Uid="SettingsDiscordCard"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8BD;}"
                Visibility="{x:Bind ViewModel.IsDiscordAvailable}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.DiscordPresence, Mode=TwoWay}" />
            </controls:SettingsCard>
            <!--  Hidden when the audio effect could not be loaded (the reason is in the log).  -->
            <controls:SettingsExpander
                x:Uid="SettingsEqualizerCard"
                HeaderIcon="{ui:FontIcon Glyph=&#xE9E9;}"
                Visibility="{x:Bind Equalizer.IsAvailable}">
                <ToggleSwitch IsOn="{x:Bind Equalizer.IsEnabled, Mode=TwoWay}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="SettingsEqualizerPresetCard">
                        <ComboBox
                            MinWidth="{StaticResource SettingsChoiceMinWidth}"
                            ItemsSource="{x:Bind Equalizer.PresetOptions}"
                            SelectedIndex="{x:Bind Equalizer.PresetIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsEqualizerBandsCard" ContentAlignment="Vertical">
                        <!--  Scrolls sideways in a narrow window instead of squeezing the sliders.  -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind Equalizer.Bands}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                                        <StackPanel Width="56" Spacing="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind GainText, Mode=OneWay}" />
                                            <Slider
                                                x:Uid="EqualizerBandSlider"
                                                Height="160"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                Maximum="12"
                                                Minimum="-12"
                                                Orientation="Vertical"
                                                StepFrequency="0.5"
                                                TickFrequency="6"
                                                TickPlacement="Outside"
                                                Value="{x:Bind Gain, Mode=TwoWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsEqualizerPreampCard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                MinWidth="48"
                                VerticalAlignment="Center"
                                Text="{x:Bind Equalizer.PreampText, Mode=OneWay}"
                                TextAlignment="Right" />
                            <Slider
                                x:Uid="SettingsEqualizerPreampSlider"
                                Width="{StaticResource SettingsChoiceMinWidth}"
                                Maximum="{x:Bind Equalizer.MaxGain}"
                                Minimum="{x:Bind Equalizer.MinGain}"
                                StepFrequency="0.5"
                                Value="{x:Bind Equalizer.Preamp, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsEqualizerResetCard">
                        <Button x:Uid="SettingsEqualizerResetButton" Command="{x:Bind Equalizer.ResetCommand}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  Storage  -->
            <TextBlock
                x:Uid="SettingsStorageHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsExpander
                x:Uid="SettingsImageCacheCard"
                Description="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE91B;}">
                <Button x:Uid="SettingsClearCacheButton" Command="{x:Bind ViewModel.ClearCacheCommand}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="SettingsCacheLimitCard">
                        <ComboBox
                            MinWidth="{StaticResource SettingsChoiceMinWidth}"
                            ItemsSource="{x:Bind ViewModel.CacheLimitOptions}"
                            SelectedIndex="{x:Bind ViewModel.CacheLimitIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsCard x:Uid="SettingsLogsCard" HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                <Button x:Uid="SettingsOpenLogsButton" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
            </controls:SettingsCard>

            <!--  Reference only: the shortcuts work anywhere in the window, except while typing.  -->
            <TextBlock
                x:Uid="SettingsShortcutsHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsExpander x:Uid="SettingsShortcutsCard" HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard ContentAlignment="Left">
                        <ItemsControl x:Uid="SettingsShortcutsList" ItemsSource="{x:Bind ViewModel.Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRow">
                                    <Grid
                                        Padding="0,2"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Gesture}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Description}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  About  -->
            <TextBlock
                x:Uid="SettingsAboutHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsExpander
                x:Uid="SettingsAboutCard"
                Description="{x:Bind ViewModel.VersionText}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Version.DisplayText}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="SettingsCommitCard" Visibility="{x:Bind ViewModel.HasCommit}">
                        <HyperlinkButton Content="{x:Bind ViewModel.Version.Commit}" NavigateUri="{x:Bind ViewModel.CommitUri}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsSourceCard">
                        <HyperlinkButton x:Uid="SettingsSourceLink" NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsIssuesCard">
                        <HyperlinkButton x:Uid="SettingsIssuesLink" NavigateUri="{x:Bind ViewModel.IssuesUri}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="SettingsLicenseCard" />
                    <controls:SettingsCard x:Uid="SettingsThirdPartyCard" ContentAlignment="Vertical">
                        <ItemsControl x:Uid="SettingsThirdPartyList" ItemsSource="{x:Bind ViewModel.Licenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="about:ThirdPartyComponent">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton
                                            Padding="0,4"
                                            Content="{x:Bind Name}"
                                            NavigateUri="{x:Bind Project}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind License}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
