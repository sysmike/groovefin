<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Square cover, name, artist.  -->
        <DataTemplate x:Key="HomeTileTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="152" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="152"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="HomeHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>
            <Button
                x:Uid="HomeRefreshButton"
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand}">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl
                Margin="0,0,0,24"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Shelves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeShelf">
                        <StackPanel Margin="0,0,0,20" Spacing="8">
                            <TextBlock
                                Margin="36,0"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Title}" />
                            <Grid Height="224">
                                <!--  Horizontal list; arrow keys move between albums, Tab leaves the list.  -->
                                <ItemsView
                                    controls:ItemMenu.IsEnabled="True"
                                    Padding="36,0"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    IsItemInvokedEnabled="True"
                                    ItemInvoked="OnAlbumInvoked"
                                    ItemTemplate="{StaticResource HomeTileTemplate}"
                                    ItemsSource="{x:Bind Albums}"
                                    Loaded="OnShelfLoaded"
                                    SelectionMode="None">
                                    <ItemsView.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="16" />
                                    </ItemsView.Layout>
                                </ItemsView>
                                <ProgressRing
                                    Margin="36,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ShowsProgress, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="HomeShelfEmpty"
                                    Margin="36,0"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Visibility="{x:Bind IsEmpty, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="HomeShelfFailed"
                                    Margin="36,0"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Visibility="{x:Bind LoadFailed, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
