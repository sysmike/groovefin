<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Grid: round image with a play button, name.  -->
        <DataTemplate x:Key="ArtistGridTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="160" Padding="0,0,0,8" Spacing="8">
                    <Grid
                        Width="160"
                        Height="160"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="80">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play, on hover (#185).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  List: round thumbnail, name.  -->
        <DataTemplate x:Key="ArtistListTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid Padding="{ThemeResource ListItemPadding}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="{ThemeResource ListThumbnailSize}"
                        Height="{ThemeResource ListThumbnailSize}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="20">
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="ArtistsHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="CountText"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ComboBox
                    x:Name="SortBox"
                    x:Uid="ArtistsSortBox"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    SelectionChanged="OnSortSelectionChanged" />
                <ToggleButton x:Uid="ArtistsDescendingToggle" IsChecked="{x:Bind ViewModel.Descending, Mode=TwoWay}">
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </ToggleButton>
                <ToggleButton x:Uid="ArtistsFavouritesToggle" IsChecked="{x:Bind ViewModel.FavouritesOnly, Mode=TwoWay}">
                    <FontIcon FontSize="16" Glyph="&#xEB51;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="GridViewToggle"
                    x:Uid="ArtistsGridViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xF0E2;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ListViewToggle"
                    x:Uid="ArtistsListViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!--  Album artists (credited on albums) or every artist credited on a track.  -->
        <SelectorBar
            x:Name="ScopeBar"
            x:Uid="ArtistsScopeBar"
            Grid.Row="1"
            Margin="28,0,36,8"
            SelectionChanged="OnScopeChanged">
            <SelectorBarItem x:Name="AlbumArtistsItem" x:Uid="ArtistsScopeAlbumArtists" />
            <SelectorBarItem x:Name="AllArtistsItem" x:Uid="ArtistsScopeAll" />
        </SelectorBar>

        <ItemsView
            controls:ItemMenu.IsEnabled="True"
            x:Name="ArtistsView"
            x:Uid="ArtistsView"
            Grid.Row="2"
            Padding="36,0,36,24"
            IsItemInvokedEnabled="True"
            ItemInvoked="OnArtistInvoked"
            ItemsSource="{x:Bind ViewModel.Artists}"
            SelectionMode="None" />

        <TextBlock
            x:Uid="ArtistsEmpty"
            Grid.Row="2"
            Margin="36,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
