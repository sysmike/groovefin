<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Square cover, name, album artist.  -->
        <DataTemplate x:Key="AlbumTileTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="152" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="152"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  Round image, name.  -->
        <DataTemplate x:Key="ArtistTileTemplate" x:DataType="vm:ArtistItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="152" Padding="0,0,0,8" Spacing="8">
                    <Grid
                        Width="152"
                        Height="152"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="76">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Image}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <Style
            x:Key="SectionHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="36,24,36,8" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="0,0,0,36">
            <TextBlock
                Margin="36,24,36,0"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Query, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <!--  A live region: Narrator reads the count when the results arrive.  -->
            <TextBlock
                x:Name="SummaryText"
                Margin="36,4,36,0"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            <ProgressRing
                x:Uid="SearchProgress"
                Margin="36,24"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!--  Horizontal shelves: arrow keys move between items, Tab moves to the next section.  -->
            <StackPanel Visibility="{x:Bind ViewModel.HasArtists, Mode=OneWay}">
                <TextBlock x:Uid="SearchArtistsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsView
                    controls:ItemMenu.IsEnabled="True"
                    x:Uid="SearchArtists"
                    Height="208"
                    Padding="36,0"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="OnArtistInvoked"
                    ItemTemplate="{StaticResource ArtistTileTemplate}"
                    ItemsSource="{x:Bind ViewModel.Artists}"
                    Loaded="OnShelfLoaded"
                    SelectionMode="None">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16" />
                    </ItemsView.Layout>
                </ItemsView>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                <TextBlock x:Uid="SearchAlbumsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsView
                    controls:ItemMenu.IsEnabled="True"
                    x:Uid="SearchAlbums"
                    Height="224"
                    Padding="36,0"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="OnAlbumInvoked"
                    ItemTemplate="{StaticResource AlbumTileTemplate}"
                    ItemsSource="{x:Bind ViewModel.Albums}"
                    Loaded="OnShelfLoaded"
                    SelectionMode="None">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16" />
                    </ItemsView.Layout>
                </ItemsView>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasTracks, Mode=OneWay}">
                <TextBlock x:Uid="SearchTracksHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView
                    controls:TrackDragSource.IsEnabled="True"
                    controls:ItemMenu.IsEnabled="True"
                    x:Uid="SearchTracks"
                    MaxWidth="880"
                    Margin="24,0"
                    HorizontalAlignment="Left"
                    IsItemClickEnabled="True"
                    ItemClick="OnTrackClick"
                    ItemsSource="{x:Bind ViewModel.Tracks}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchTrackItem">
                            <Grid
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Duration}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasPlaylists, Mode=OneWay}">
                <TextBlock x:Uid="SearchPlaylistsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <ListView
                    controls:ItemMenu.IsEnabled="True"
                    x:Uid="SearchPlaylists"
                    MaxWidth="880"
                    Margin="24,0"
                    HorizontalAlignment="Left"
                    IsItemClickEnabled="True"
                    ItemClick="OnPlaylistClick"
                    ItemsSource="{x:Bind ViewModel.Playlists}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistItem">
                            <Grid
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="48"
                                    Height="48"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8FD;" />
                                    <Image
                                        controls:Artwork.Request="{x:Bind Image}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
