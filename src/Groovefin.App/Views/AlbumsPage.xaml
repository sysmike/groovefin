<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Grid: square cover with play and songs buttons, name, artist.  -->
        <DataTemplate x:Key="AlbumGridTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel Width="168" Padding="0,0,0,8" Spacing="6">
                    <Grid
                        Height="168"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            controls:Artwork.Request="{x:Bind Cover}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                        <!--  Play and the songs popup, on hover (#185).  -->
                        <controls:CoverActions Tag="{x:Bind}" />
                    </Grid>
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <!--  List: thumbnail, name, artist, year.  -->
        <DataTemplate x:Key="AlbumListTemplate" x:DataType="vm:AlbumItem">
            <ItemContainer controls:TrackDragSource.IsEnabled="True" AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid Padding="{ThemeResource ListItemPadding}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="{ThemeResource ListThumbnailSize}"
                        Height="{ThemeResource ListThumbnailSize}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <Image
                            controls:Artwork.Request="{x:Bind conv:Covers.Thumbnail(Cover)}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Year}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="AlbumsHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <ProgressRing
                    x:Uid="LoadingRing"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ComboBox
                    x:Name="SortBox"
                    x:Uid="AlbumsSortBox"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    SelectionChanged="OnSortSelectionChanged" />
                <ToggleButton
                    x:Uid="AlbumsDescendingToggle"
                    IsChecked="{x:Bind ViewModel.Descending, Mode=TwoWay}">
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </ToggleButton>
                <Button x:Name="FilterButton" x:Uid="AlbumsFilterButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                        <FontIcon
                            FontSize="8"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEA3B;"
                            Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel MinWidth="260" Spacing="12">
                                <ToggleSwitch x:Uid="AlbumsFavouritesSwitch" IsOn="{x:Bind ViewModel.FavouritesOnly, Mode=TwoWay}" />
                                <ComboBox
                                    x:Name="GenreBox"
                                    x:Uid="AlbumsGenreBox"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnGenreSelectionChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        x:Name="MinYearBox"
                                        x:Uid="AlbumsMinYearBox"
                                        Width="120"
                                        Maximum="2100"
                                        Minimum="1800"
                                        ValueChanged="OnYearChanged" />
                                    <NumberBox
                                        x:Name="MaxYearBox"
                                        x:Uid="AlbumsMaxYearBox"
                                        Width="120"
                                        Maximum="2100"
                                        Minimum="1800"
                                        ValueChanged="OnYearChanged" />
                                </StackPanel>
                                <Button x:Uid="AlbumsClearFiltersButton" Click="OnClearFiltersClick" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton
                    x:Name="GridViewToggle"
                    x:Uid="AlbumsGridViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xF0E2;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ListViewToggle"
                    x:Uid="AlbumsListViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <ItemsView
            controls:ItemMenu.IsEnabled="True"
            x:Name="AlbumsView"
            x:Uid="AlbumsView"
            Grid.Row="1"
            Padding="36,0,36,24"
            IsItemInvokedEnabled="True"
            ItemInvoked="OnAlbumInvoked"
            ItemsSource="{x:Bind ViewModel.Albums}"
            SelectionMode="None" />

        <TextBlock
            x:Uid="AlbumsEmpty"
            Grid.Row="1"
            Margin="36,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
