<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Groovefin.Core.Models"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel>
            <!--  Hero header: blurred cover behind in-app acrylic, then cover, title and actions.  -->
            <Grid Visibility="{x:Bind ViewModel.HasAlbum, Mode=OneWay}">
                <Image
                    controls:Artwork.Request="{x:Bind ViewModel.Background, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
                <Rectangle Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

                <Grid Padding="36,32,36,24" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="232"
                        Height="232"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <FontIcon
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            x:Name="CoverImage"
                            controls:Artwork.Request="{x:Bind ViewModel.Cover, Mode=OneWay}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <TextBlock
                            x:Uid="AlbumKind"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            MaxLines="2"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ArtistRef">
                                    <HyperlinkButton
                                        Padding="4,2"
                                        Click="OnArtistClick"
                                        Content="{x:Bind Name}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Details, Mode=OneWay}" />

                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Uid="AlbumPlayButton"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    <TextBlock x:Uid="AlbumPlayText" />
                                </StackPanel>
                            </Button>
                            <Button x:Uid="AlbumShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                            </Button>
                            <Button x:Uid="AlbumQueueButton" Command="{x:Bind ViewModel.AddToQueueCommand}">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                x:Name="AddToPlaylistButton"
                                x:Uid="AlbumAddToPlaylistButton"
                                Click="OnAddToPlaylistClick"
                                IsEnabled="{x:Bind ViewModel.HasTracks, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xECC8;" />
                            </Button>
                            <ToggleButton
                                x:Uid="AlbumFavouriteButton"
                                Command="{x:Bind ViewModel.ToggleFavouriteCommand}"
                                IsChecked="{x:Bind ViewModel.IsFavourite, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="{x:Bind conv:Glyphs.Heart(ViewModel.IsFavourite), Mode=OneWay}" />
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <ProgressRing
                Margin="36,48"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                x:Uid="AlbumLoadFailed"
                Margin="36,24"
                Style="{StaticResource BodyTextBlockStyle}"
                Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />

            <!--  Tracks, grouped by disc.  -->
            <ItemsControl
                Margin="36,16,36,36"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Discs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiscGroup">
                        <StackPanel Margin="0,0,0,16" Spacing="4">
                            <TextBlock
                                Margin="12,8,0,4"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Header}"
                                Visibility="{x:Bind HasHeader}" />
                            <ListView
                                x:Uid="AlbumTracks"
                                ContextRequested="OnTrackContextRequested"
                                IsItemClickEnabled="True"
                                ItemClick="OnTrackClick"
                                ItemsSource="{x:Bind Tracks}"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackItem">
                                        <Grid
                                            Padding="0,6"
                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                            ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalTextAlignment="Right"
                                                Text="{x:Bind Number}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <!--  Track artists as links (compilations, features); also in the row's context menu.  -->
                                                <ItemsRepeater ItemsSource="{x:Bind ArtistLinks}" Visibility="{x:Bind HasArtist}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Horizontal" Spacing="2" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ArtistRef">
                                                            <HyperlinkButton
                                                                Padding="0"
                                                                Click="OnArtistClick"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                            </HyperlinkButton>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                            <ToggleButton
                                                x:Uid="AlbumTrackFavouriteButton"
                                                Grid.Column="2"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                                BorderThickness="0"
                                                Click="OnTrackFavouriteClick"
                                                IsChecked="{x:Bind IsFavourite, Mode=OneWay}">
                                                <FontIcon FontSize="12" Glyph="{x:Bind conv:Glyphs.Heart(IsFavourite), Mode=OneWay}" />
                                            </ToggleButton>
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Duration}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
