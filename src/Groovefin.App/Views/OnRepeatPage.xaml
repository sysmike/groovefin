<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.OnRepeatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:conv="using:Groovefin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: name, what the list is, and its actions (#251).  -->
        <StackPanel Padding="36,32,36,16" Spacing="8">
            <TextBlock
                x:Uid="OnRepeatHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock
                x:Uid="OnRepeatSubtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="OnRepeatPlayButton"
                    Command="{x:Bind ViewModel.PlayCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="OnRepeatPlayText" />
                    </StackPanel>
                </Button>
                <Button x:Uid="OnRepeatShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                </Button>
                <Button x:Uid="OnRepeatQueueButton" Command="{x:Bind ViewModel.AddToQueueCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
                <Button x:Uid="OnRepeatSaveButton" Command="{x:Bind ViewModel.SaveAsPlaylistCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        <TextBlock x:Uid="OnRepeatSaveText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!--  Collapsed when idle: an inactive ring still takes its space (#155).  -->
        <ProgressRing
            x:Uid="LoadingRing"
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="36,24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock
            x:Uid="OnRepeatLoadFailed"
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="36,24"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}" />
        <TextBlock
            x:Uid="OnRepeatEmpty"
            Grid.Row="1"
            AutomationProperties.AutomationId="OnRepeatEmpty"
            Grid.RowSpan="2"
            Margin="36,24"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <!--
            Column headers like the playlist's (#245), with a Plays column: a 36 px row of semibold labels with a
            divider below and a thin line after each column, the same insets as the rows. They do not sort: the
            list is in rank order.
        -->
        <Grid
            Grid.Row="1"
            Height="36"
            Margin="52,0,48,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
            <Grid.Resources>
                <Style x:Key="ColumnDividerStyle" TargetType="Rectangle">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="0,8,-8,8" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Style>
                <Style
                    x:Key="ColumnLabelStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="2" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="3" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="4" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="5" Style="{StaticResource ColumnDividerStyle}" />
            <Rectangle Grid.Column="6" Style="{StaticResource ColumnDividerStyle}" />
            <TextBlock
                x:Uid="AlbumColumnNumber"
                Grid.Column="0"
                HorizontalTextAlignment="Right"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="AlbumColumnTitle"
                Grid.Column="1"
                AutomationProperties.AutomationId="OnRepeatColumnTitle"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="PlaylistColumnArtist"
                Grid.Column="2"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="PlaylistColumnAlbum"
                Grid.Column="3"
                Style="{StaticResource ColumnLabelStyle}" />
            <TextBlock
                x:Uid="OnRepeatColumnPlays"
                Grid.Column="4"
                HorizontalTextAlignment="Right"
                Style="{StaticResource ColumnLabelStyle}" />
            <FontIcon
                Grid.Column="5"
                FontSize="12"
                Glyph="&#xEB51;" />
            <FontIcon
                Grid.Column="6"
                HorizontalAlignment="Right"
                FontSize="12"
                Glyph="&#xE823;" />
        </Grid>

        <!--  The tracks: click plays the list from there; the context menu (or Shift+F10) offers what every track does.  -->
        <ListView
            controls:ViewMemory.IsEnabled="True"
            controls:ItemMenu.IsEnabled="True"
            controls:TrackDragSource.IsEnabled="True"
            x:Uid="OnRepeatEntries"
            Grid.Row="2"
            Padding="36,0,36,24"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnRepeatItem">
                    <Grid
                        Padding="{ThemeResource TrackRowPadding}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <controls:TrackNumber
                            VerticalAlignment="Center"
                            IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                            Text="{x:Bind Number}" />
                        <controls:TrackText
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                            Text="{x:Bind Name}" />
                        <controls:TrackText
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                            IsSecondary="True"
                            Text="{x:Bind Artist}" />
                        <controls:TrackText
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            IsPlaying="{x:Bind IsCurrent, Mode=OneWay}"
                            IsSecondary="True"
                            Text="{x:Bind Album}" />
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalTextAlignment="Right"
                            Text="{x:Bind PlaysCount}" />
                        <ToggleButton
                            x:Uid="AlbumTrackFavouriteButton"
                            Grid.Column="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderThickness="0"
                            Click="OnEntryFavouriteClick"
                            IsChecked="{x:Bind IsFavourite, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="{x:Bind conv:Glyphs.Heart(IsFavourite), Mode=OneWay}" />
                        </ToggleButton>
                        <TextBlock
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalTextAlignment="Right"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
