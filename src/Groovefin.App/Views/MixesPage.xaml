<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.MixesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: what mixes are, and a new one (#401).  -->
        <StackPanel Padding="36,32,36,16" Spacing="8">
            <TextBlock
                x:Uid="MixesHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock
                x:Uid="MixesSubtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <Button
                x:Uid="MixesNewButton"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="MixesNewButton"
                Command="{x:Bind ViewModel.NewCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Uid="MixesNewText" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            x:Uid="MixesEmpty"
            Grid.Row="1"
            Margin="36,8"
            AutomationProperties.AutomationId="MixesEmpty"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <!--  The mixes: click opens one; each row plays, changes or deletes its mix.  -->
        <ListView
            x:Uid="MixesList"
            Grid.Row="1"
            Padding="36,0,36,24"
            AutomationProperties.AutomationId="MixesList"
            IsItemClickEnabled="True"
            ItemClick="OnMixClick"
            ItemsSource="{x:Bind ViewModel.Mixes}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MixItem">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE71C;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Summary}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="{x:Bind PlayName}"
                                Click="OnPlayClick"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind PlayName}">
                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                x:Uid="MixEditButton"
                                Click="OnEditClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                            </Button>
                            <Button
                                x:Uid="MixDeleteButton"
                                Click="OnDeleteClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
