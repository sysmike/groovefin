<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  A card with the genre's name.  -->
        <DataTemplate x:Key="GenreTileTemplate" x:DataType="vm:GenreItem">
            <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                <Grid
                    Width="200"
                    Height="88"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8EC;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="36,24,36,12"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                x:Uid="GenresHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <ItemsView
            x:Uid="GenresView"
            Grid.Row="1"
            Padding="36,0,36,24"
            controls:ItemMenu.IsEnabled="True"
            IsItemInvokedEnabled="True"
            ItemInvoked="OnGenreInvoked"
            ItemTemplate="{StaticResource GenreTileTemplate}"
            ItemsSource="{x:Bind ViewModel.Genres}"
            SelectionMode="None">
            <ItemsView.Layout>
                <UniformGridLayout
                    MinColumnSpacing="12"
                    MinItemWidth="200"
                    MinRowSpacing="12" />
            </ItemsView.Layout>
        </ItemsView>
        <TextBlock
            x:Uid="GenresEmpty"
            Grid.Row="1"
            Margin="36,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
