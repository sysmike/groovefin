<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Groovefin.App.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Groovefin.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Groovefin.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  The cards grow until whole columns fill each row (#232).  -->
        <controls:TileSize x:Key="GenreTile" MinWidth="200" />

        <!--  Grid: a card with the genre's name.  -->
        <DataTemplate x:Key="GenreTileTemplate" x:DataType="vm:GenreItem">
            <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                <Grid
                    Width="{Binding Width, Source={StaticResource GenreTile}}"
                    Height="88"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8EC;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <!--  Play, on hover (#191): over the whole card, padding included.  -->
                    <controls:CoverActions
                        Grid.ColumnSpan="2"
                        Margin="-16,-12"
                        Tag="{x:Bind}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <!--  List (#450): the genre icon and the name.  -->
        <DataTemplate x:Key="GenreListTemplate" x:DataType="vm:GenreItem">
            <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                <Grid Padding="{ThemeResource ListItemPadding}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="{ThemeResource ListThumbnailSize}"
                        Height="{ThemeResource ListThumbnailSize}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8EC;" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,24,36,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Uid="GenresHeader"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing
                    x:Uid="LoadingRing"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    x:Name="GridViewToggle"
                    x:Uid="GenresGridViewToggle"
                    AutomationProperties.AutomationId="GenresGridViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xF0E2;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ListViewToggle"
                    x:Uid="GenresListViewToggle"
                    AutomationProperties.AutomationId="GenresListViewToggle"
                    Click="OnViewModeClick">
                    <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!--  Its template and layout follow the view mode: set from code.  -->
        <ItemsView
            controls:ViewMemory.IsEnabled="True"
            x:Name="GenresView"
            x:Uid="GenresView"
            Grid.Row="1"
            controls:TileSize.Source="{StaticResource GenreTile}"
            Padding="36,0,36,24"
            controls:ItemMenu.IsEnabled="True"
            IsItemInvokedEnabled="True"
            ItemInvoked="OnGenreInvoked"
            ItemsSource="{x:Bind ViewModel.Genres}"
            SelectionMode="None" />
        <TextBlock
            x:Uid="GenresEmpty"
            Grid.Row="1"
            Margin="36,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
