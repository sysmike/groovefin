<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>$(GroovefinWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(GroovefinWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Groovefin.App</RootNamespace>
    <AssemblyName>Groovefin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en-US;de-DE</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- One runtime identifier per solution platform. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <!-- Unconditional so that a plain restore (no -c Release) already fetches the crossgen pack. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- DI and XAML rely on reflection; trimming stays off until the app is trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to the output too: MSIX packaging takes all content, the unpackaged publish only copied files. -->
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Taskbar\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Groovefin.Core\Groovefin.Core.csproj" />
    <ProjectReference Include="..\Groovefin.Jellyfin\Groovefin.Jellyfin.csproj" />
    <ProjectReference Include="..\Groovefin.Playback.Windows\Groovefin.Playback.Windows.csproj" />
    <!-- Not referenced as an assembly: only its native build is shipped (see PublishAudioEffects below). -->
    <ProjectReference Include="..\Groovefin.Audio.Effects\Groovefin.Audio.Effects.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The equalizer's audio effect (#65). MediaPlayer creates it by its WinRT class name from
    Groovefin.Audio.Effects.dll, which both manifests register; it has to be a native DLL, so it is published
    with NativeAOT for this app's runtime identifier and copied next to Groovefin.exe (and into the MSIX).
    NativeAOT needs the MSVC linker (Visual Studio's "Desktop development with C++"). Without it, build with
    -p:GroovefinAudioEffects=false: the app then starts without the equalizer and says so in its log.
  -->
  <PropertyGroup Label="Audio effects">
    <GroovefinAudioEffects Condition="'$(GroovefinAudioEffects)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</GroovefinAudioEffects>
    <GroovefinAudioEffectsDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)AudioEffects\$(Configuration)\$(RuntimeIdentifier)\</GroovefinAudioEffectsDir>
  </PropertyGroup>

  <Target Name="PublishAudioEffects" BeforeTargets="AssignTargetPaths" Condition="'$(GroovefinAudioEffects)' == 'true'">
    <!-- The app's packaging and publish settings do not apply to the effect; NativeAOT is always self-contained. -->
    <MSBuild
      Projects="..\Groovefin.Audio.Effects\Groovefin.Audio.Effects.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishDir=$(GroovefinAudioEffectsDir)"
      RemoveProperties="Platform;WindowsPackageType;WindowsAppSDKSelfContained;GenerateAppxPackageOnBuild;AppxPackageSigningEnabled;AppxPackageDir;PublishReadyToRun;_IsPublishing" />
    <ItemGroup>
      <Content Include="$(GroovefinAudioEffectsDir)Groovefin.Audio.Effects.dll" Link="Groovefin.Audio.Effects.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability lets the single-project MSIX tooling in Visual Studio
    activate before the Windows App SDK package is restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
