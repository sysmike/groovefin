<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Groovefin.app" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11: required for features such as the custom title bar in unpackaged mode. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    The equalizer's audio effect for the unpackaged app (registration-free WinRT), which MediaPlayer creates
    by its class name (#65). The MSIX registers it in Package.appxmanifest.
  -->
  <file name="Groovefin.Audio.Effects.dll">
    <activatableClass name="Groovefin.Audio.Effects.EqualizerEffect" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
  </file>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
