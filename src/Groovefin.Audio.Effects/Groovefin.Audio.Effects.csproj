<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The equalizer as a Media Foundation audio effect (#65). MediaPlayer creates effects by their WinRT
    class name, so this has to be a native DLL exporting DllGetActivationFactory: Groovefin.App publishes
    it with NativeAOT for its runtime identifier and ships the DLL next to Groovefin.exe. NativeAOT keeps it
    independent of a .NET installation (the unpackaged app is self-contained). See docs/architecture.md.
  -->
  <PropertyGroup>
    <!-- Like the app: cswinrt.exe reads the installed Windows SDK of this version (10.0.22000 is not on the CI runners). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>$(GroovefinWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(GroovefinWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Groovefin.Audio.Effects</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <CsWinRTComponent>true</CsWinRTComponent>
    <PublishAot>true</PublishAot>
    <!--
      Without a WinUI reference C#/WinRT's AOT generator runs in OptIn mode and generates no marshalling code
      for what the effect hands to Windows; that threw NotSupportedException inside Media Foundation (#167).
      Auto finds those types, level 2 makes a missed one a warning (an error here). Auto also needs the
      exports set by hand: C#/WinRT only turns them on for the value "true".
    -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <CsWinRTAotExportsEnabled>true</CsWinRTAotExportsEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Lock file">
    <!--
      No lock file: NativeAOT adds the SDK's own ILCompiler and ILLink packages, whose version changes with
      every .NET patch the build machine installs. The one real package, C#/WinRT, is pinned centrally.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private: the app keeps the C#/WinRT of its Windows SDK projection. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Groovefin.Audio\Groovefin.Audio.csproj" />
  </ItemGroup>

</Project>
